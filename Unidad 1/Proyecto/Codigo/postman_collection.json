{
  "info": {"name": "AUTH–STEGO | Sustentación de seguridad", "description": "Pruebas reproducibles del proyecto. Los JWT se guardan sólo en el entorno local de Postman. No incluye claves ni tokens activos.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [
    {"name":"01. Sesiones","item":[
      {"name":"Login ADMIN","event":[{"listen":"test","script":{"exec":["pm.test('200 y JWT',()=>pm.response.to.have.status(200));","const j=pm.response.json(); pm.environment.set('adminJwt',j.access_token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"identity\":\"{{adminIdentity}}\",\"password\":\"{{adminPassword}}\"}"},"url":"{{authUrl}}/api/auth/login"}},
      {"name":"Login ANALYST","event":[{"listen":"test","script":{"exec":["pm.test('200 y JWT',()=>pm.response.to.have.status(200));","pm.environment.set('analystJwt',pm.response.json().access_token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"identity\":\"{{analystIdentity}}\",\"password\":\"{{analystPassword}}\"}"},"url":"{{authUrl}}/api/auth/login"}},
      {"name":"Login USER","event":[{"listen":"test","script":{"exec":["pm.test('200 y JWT',()=>pm.response.to.have.status(200));","pm.environment.set('userJwt',pm.response.json().access_token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"identity\":\"{{userIdentity}}\",\"password\":\"{{userPassword}}\"}"},"url":"{{authUrl}}/api/auth/login"}},
      {"name":"Inspeccionar JWT (RS256, sin roles)","event":[{"listen":"test","script":{"exec":["const t=pm.environment.get('analystJwt'); const [h,p]=t.split('.');","const d=s=>JSON.parse(atob(s.replace(/-/g,'+').replace(/_/g,'/'))); const header=d(h), payload=d(p);","console.log({header,payload}); pm.test('alg RS256',()=>pm.expect(header.alg).to.eql('RS256'));","pm.test('payload sin roles',()=>pm.expect(payload).not.to.have.property('roles'));","pm.test('claims de seguridad',()=>{pm.expect(payload).to.include.all.keys('sub','exp','iss','aud','typ','tokenVersion');});"]}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{analystJwt}}"}],"url":"{{authUrl}}/api/auth/profile"}}
    ]},
    {"name":"02. Firma y claims","item":[
      {"name":"STEGO sin token → 401","event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}],"request":{"method":"POST","body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{normalPng}}"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}},
      {"name":"JWT manipulado (username + rol falso) → 401","event":[{"listen":"prerequest","script":{"exec":["const t=pm.environment.get('analystJwt').split('.'); const b=s=>JSON.parse(atob(s.replace(/-/g,'+').replace(/_/g,'/')));","const p=b(t[1]); p.username='atacante'; p.roles=['ADMIN'];","const enc=o=>btoa(JSON.stringify(o)).replace(/=/g,'').split('+').join('-').split('/').join('_');","pm.variables.set('tamperedJwt',t[0]+'.'+enc(p)+'.'+t[2]);"]}},{"listen":"test","script":{"exec":["pm.test('401 por firma inválida',()=>pm.response.to.have.status(401));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{tamperedJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{normalPng}}"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}},
      {"name":"JWT expirado → 401","description":"Genere expiredJwt localmente con auth/scripts/create-expired-token.mjs; nunca use jwt.io.","event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{expiredJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{normalPng}}"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}}
    ]},
    {"name":"03. RBAC dinámico","item":[
      {"name":"USER analiza → 403","event":[{"listen":"test","script":{"exec":["pm.test('403 por rol vigente',()=>pm.response.to.have.status(403));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{userJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{normalPng}}"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}},
      {"name":"ANALYST analiza → 201","event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","if(pm.response.code===201) pm.environment.set('analystAnalysisId',pm.response.json().id);"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{analystJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{stegoPng}}"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}},
      {"name":"ADMIN analiza → 201","event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{normalPng}}"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}},
      {"name":"Retirar asignación ANALYST","event":[{"listen":"test","script":{"exec":["pm.test('asignación retirada',()=>pm.response.to.have.status(200));"]}}],"request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{adminJwt}}"}],"url":"{{authUrl}}/api/user-roles/{{analystAssignmentId}}"}},
      {"name":"Revocado: reutilizar mismo JWT ANALYST → 403","description":"No vuelva a iniciar sesión entre retirar la asignación y esta solicitud.","event":[{"listen":"test","script":{"exec":["pm.test('403 inmediato',()=>pm.response.to.have.status(403));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{analystJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{normalPng}}"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}}
    ]},
    {"name":"04. Logout, propiedad y disponibilidad","item":[
      {"name":"Logout ANALYST","event":[{"listen":"test","script":{"exec":["pm.test('logout correcto',()=>pm.response.to.have.status(201));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{analystJwt}}"}],"url":"{{authUrl}}/api/auth/logout"}},
      {"name":"Reutilizar JWT después de logout → 401","event":[{"listen":"test","script":{"exec":["pm.test('401 tokenVersion',()=>pm.response.to.have.status(401));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{analystJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{normalPng}}"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}},
      {"name":"Consultar resultado ajeno → 403","event":[{"listen":"test","script":{"exec":["pm.test('403 IDOR impedido',()=>pm.response.to.have.status(403));"]}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{userJwt}}"}],"url":"{{stegoUrl}}/api/steganography/results/{{analystAnalysisId}}"}},
      {"name":"Fail closed (AUTH detenido) → 503","description":"Ejecute docker compose stop auth, envíe esta solicitud y luego docker compose start auth.","event":[{"listen":"test","script":{"exec":["pm.test('503 sin autoridad',()=>pm.response.to.have.status(503));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{normalPng}}"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}}
    ]},
    {"name":"05. Archivos T10","item":[
      {"name":"Firma/extensión incompatible → 415","event":[{"listen":"test","script":{"exec":["pm.test('415',()=>pm.response.to.have.status(415));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{fakePng}}","contentType":"image/png"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}},
      {"name":"PNG corrupto/truncado → 422","event":[{"listen":"test","script":{"exec":["pm.test('422',()=>pm.response.to.have.status(422));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{corruptPng}}","contentType":"image/png"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}},
      {"name":"Archivo demasiado grande → 413","event":[{"listen":"test","script":{"exec":["pm.test('413',()=>pm.response.to.have.status(413));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminJwt}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":"{{oversizedPng}}","contentType":"image/png"}]},"url":"{{stegoUrl}}/api/steganography/analyze"}}
    ]},
    {"name":"06. Inspección operativa","description":"Los logs y PostgreSQL se consultan localmente: docker compose logs --tail 100 auth stego; docker compose exec auth-db psql -U auth -d auth -c \"SELECT u.username,r.rol FROM users u JOIN user_roles ur ON ur.user_id=u.id JOIN roles r ON r.id=ur.role_id;\"","item":[]}
  ]
}
