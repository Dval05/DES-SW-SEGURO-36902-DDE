PORT=3002
JWT_PUBLIC_KEY_PATH=../secrets/jwt/public.pem
JWT_ISSUER=secure-auth
JWT_AUDIENCE=secure-backend
AUTH_INTERNAL_URL=https://localhost:3001
STEGO_SERVICE_TOKEN=replace-with-at-least-32-random-characters
AUTH_TIMEOUT_MS=3000
MAX_FILE_BYTES=5242880
MAX_PIXELS=16000000
LSB_THRESHOLD=0.97
STEGO_DB_PATH=./data/stego.db
NODE_EXTRA_CA_CERTS=../secrets/tls/ca.crt
